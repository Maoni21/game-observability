          },
          "expr": "{service=\"game-telemetry\", origin=\"$origin\", event=\"game_completed\"} |~ `\"score\":\\s*\\[3,\\s*0\\]` | json map=\"server.map\" | map=\"vault\"",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
