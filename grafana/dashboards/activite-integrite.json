{
  "uid": "activite-integrite",
  "title": "3. Activité de jeu et intégrité des parties",
  "description": "Quelqu'un abuse-t-il du jeu ? (farming, rapports falsifiés)",
  "tags": [
    "game-telemetry"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "time": {
    "from": "2026-09-19T20:00:00.000Z",
    "to": "2026-09-27T00:00:00.000Z"
  },
  "refresh": "",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Combien de parties se sont terminées ?",
      "description": "Parties terminées sur la période affichée.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"game-telemetry\", origin=\"$origin\", event=\"game_completed\"} [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Combien de parties ont été mises en quarantaine ?",
      "description": "Parties marquées quarantined par le serveur (comportement jugé anormal).",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"game-telemetry\", origin=\"$origin\", event=\"game_completed\"} | json q=\"server.quarantined\" | q=\"true\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Combien de parties se terminent en 3-0 sur vault ?",
      "description": "Signature du farming. En jeu normal, environ 3 % des parties.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"game-telemetry\", origin=\"$origin\", event=\"game_completed\"} |~ `\"score\":\\s*\\[3,\\s*0\\]` | json map=\"server.map\" | map=\"vault\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Combien de rapports impossibles ont été reçus ?",
      "description": "Rapports classés falsifie : fps > 240 ou étape de rendu négative.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"game-telemetry\", origin=\"$origin\", event=\"perf_spike\"} | json category | category=\"falsifie\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Combien de parties se terminent par heure, sur quelle carte ?",
      "description": "Activité de jeu par carte.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (map) (count_over_time({service=\"game-telemetry\", origin=\"$origin\", event=\"game_completed\"} | json map=\"server.map\" [1h]))",
          "legendFormat": "{{map}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "interval": "1h"
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Quelle part des parties se termine en 3-0 sur vault ?",
      "description": "Ratio sur 1 heure glissante. Au-dessus de 25 % (ligne rouge), l'alerte FarmingSuspecte se déclenche.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "(sum(count_over_time({service=\"game-telemetry\", origin=\"$origin\", event=\"game_completed\"} |~ `\"score\":\\s*\\[3,\\s*0\\]` | json map=\"server.map\" | map=\"vault\" [1h])) or vector(0)) / sum(count_over_time({service=\"game-telemetry\", origin=\"$origin\", event=\"game_completed\"} [1h]))",
          "legendFormat": "part de 3-0 sur vault",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "interval": "15m"
    },
    {
      "id": 7,
      "type": "table",
      "title": "Quels clients envoient des rapports impossibles ?",
      "description": "Identifiant client extrait de l'id du rapport (P-<client>-<n>). Au moins 3 rapports déclenchent RapportsFalsifies.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (client) (count_over_time({service=\"game-telemetry\", origin=\"$origin\", event=\"perf_spike\"} | json category | category=\"falsifie\" | regexp `\"id\":\\s*\"P-(?P<client>[0-9a-f]{8})` [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Rapports impossibles",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Rapports impossibles"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Les serveurs de jeu ont-ils des pauses de simulation ?",
      "description": "Plus long écart entre deux ticks serveur (tickGapMaxMs) par heure. Au-delà de 150 ms, les joueurs voient des saccades réseau.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max_over_time({service=\"game-telemetry\", origin=\"$origin\", event=\"game_completed\"} | json g=\"server.tickGapMaxMs\" | unwrap g [1h]) by (origin)",
          "legendFormat": "tickGapMaxMs max",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "interval": "1h"
    },
    {
